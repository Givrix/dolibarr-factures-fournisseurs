# Copier ce fichier vers .env a la racine du depot, puis renseigner MISTRAL_API_KEY.
# La cle est utilisee par le worker local (`mistral apps dev`) et par le script
# scripts/run_import.py. En deploiement gere, la plateforme injecte elle-meme
# les identifiants (token de compte de service).
#
# DOLIBARR_BASE_URL : URL de l'API REST Dolibarr (index.php de l'API).
# DOLIBARR_API_TOKEN : cle API de l'utilisateur Dolibarr (envoyee en header
# DOLAPIKEY). L'utilisateur doit avoir les droits API sur les tiers, les
# factures fournisseurs, les banques et la lecture des dictionnaires.
# En deploiement gere, definir ces variables dans les settings de l'app.
#
# DEPLOYMENT_NAME : identifiant stable du deploiement du worker. Il nomme le
# groupe de workers qui execute les workflows et sert de file de tache : le
# worker s'y enregistre et les executions y sont routees. La meme valeur doit
# etre utilisee par le worker et par le lanceur (le script run_import.py la
# lit automatiquement). En local, n'importe quel nom stable convient.
APP_NAME=dolibarr-factures-fournisseurs
DEPLOYMENT_NAME=dolibarr-factures-fournisseurs-dev
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
WORKFLOWS_BASE_URL=https://api.mistral.ai
DOLIBARR_BASE_URL=https://dolibarr.anelosimus.info/htdocs/api/index.php
DOLIBARR_API_TOKEN=
LOG_LEVEL=INFO
LOG_FORMAT=console
MISTRAL_SECRETS_ENABLED=false
TELEMETRY_ENABLED=false
